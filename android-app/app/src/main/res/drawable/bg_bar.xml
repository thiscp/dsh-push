<?xml version="1.0" encoding="utf-8"?>
<!-- 网页原生顶栏底板（v1.33.43，用户 m08435/m08451「标签栏风格和整体不搭」）。
     与消息卡片同源：80% 主题卡底色 + 1dp 主题描边，圆角 18dp（28dp 高的胶囊观感）。
     此前顶栏**完全没有背景**，标题与关闭钮直接浮在壁纸色上，跟 App 的卡片语言脱节。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/dshCardBg" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="?attr/dshCardStroke" />
</shape>
