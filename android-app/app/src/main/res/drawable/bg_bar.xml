<?xml version="1.0" encoding="utf-8"?>
<!-- 网页原生顶栏底板（v1.33.43 起，v1.33.44 改为通栏）。
     v1.33.43 首版做成「浮动圆角卡片 + 四周外边距」，实机反馈 m09845「顶部栏还有一圈灰色的
     背景」——那圈灰不是卡片自己的，而是卡片 10dp 外边距**露出来的壁纸**（浅色主题壁纸 #EEEDF3，
     而下方网页玻璃是 #F8F7FC，两者差一档，围着卡片就形成一道灰框）。
     ⇒ 改回**通栏**：左右顶到屏幕边、无外边距，只保留 1dp 底部细线做与网页的分隔。
     通栏后不再有「缝」，也就没有那圈灰。动画不受影响（setBarShown 动画的是外层高度）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/dshCardBg" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/dshCardStroke" />
        </shape>
    </item>
</layer-list>
